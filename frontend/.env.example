# =============================================================================
# Frontend Environment Configuration
# =============================================================================

# Backend API URL (must match backend PORT configuration)
VITE_API_URL=http://localhost:8001

# WebSocket URL (same as API URL, WebSocket will use /ws endpoint)
VITE_WS_URL=ws://localhost:8001

# =============================================================================
# NOTES:
# =============================================================================
# 1. Vite uses VITE_ prefix for environment variables
# 2. Copy this file to .env for local development
# 3. Backend must be running on the configured port (default: 8001)
