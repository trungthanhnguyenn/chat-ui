# =============================================================================
# API Configuration - OpenAI Compatible Endpoints
# =============================================================================
# Primary OpenAI/OpenRouter API key
OPENAI_API_KEY=sk-or-v1-your-openrouter-key-here

# Base URL for OpenAI compatible API (OpenRouter, OpenAI, or custom)
OPENAI_BASE_URL=https://openrouter.ai/api/v1

# Model name to use (examples: openai/gpt-4-turbo-preview, anthropic/claude-3-opus, etc.)
MODEL_NAME=openai/gpt-4-turbo-preview

# =============================================================================
# Custom Agent Configuration (Optional)
# =============================================================================
# Port for custom agent 1 (if using custom agent provider)
# CUSTOM_PORT_1=8004

# Route for custom agent 1 streaming endpoint
# ROUTE_CUSTOM_PORT_1=/v1/agent/finance/response_stream

# Add more custom agents as needed:
# CUSTOM_PORT_2=8005
# ROUTE_CUSTOM_PORT_2=/v1/agent/other/stream

# =============================================================================
# Database Configuration
# =============================================================================
# SQLite (default - recommended for development)
DATABASE_URL=sqlite+aiosqlite:///./chatbot.db

# PostgreSQL (uncomment and configure for production)
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/chatbot

# =============================================================================
# Server Configuration
# =============================================================================
# Host to bind the server (0.0.0.0 for all interfaces, 127.0.0.1 for localhost only)
HOST=0.0.0.0

# Port for the backend server
PORT=8001

# CORS Origins - comma-separated list of allowed origins (JSON array format)
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# =============================================================================
# Security Configuration
# =============================================================================
# Secret key for JWT tokens (CHANGE THIS IN PRODUCTION!)
SECRET_KEY=your-secret-key-change-in-production-min-32-chars

# Token Time-To-Live in seconds (default: 864000 = 10 days)
TTL=864000

# =============================================================================
# Logging Configuration
# =============================================================================
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# =============================================================================
# IMPORTANT NOTES:
# =============================================================================
# 1. Copy this file to .env and fill in your actual values
# 2. NEVER commit .env file to version control
# 3. Change SECRET_KEY to a strong random string in production
# 4. For OpenRouter: Get API key from https://openrouter.ai/
# 5. For Custom Agents: Configure CUSTOM_PORT_* and ROUTE_CUSTOM_PORT_* variables
# 6. Provider auto-discovery: The system automatically detects available providers
#    based on configured environment variables
